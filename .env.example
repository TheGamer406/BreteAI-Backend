# Copiar a .env y ajustar. .env nunca se versiona (ver .gitignore).
# Debe quedar sincronizado con las variables que lee app/config.py.

# Conexión a la DB levantada por BreteAI-Infra (docker-compose)
DATABASE_URL=postgresql+psycopg://breteai:changeme@localhost:5432/breteai

# API (default seguro: solo localhost; en Docker el compose usa 0.0.0.0)
API_HOST=127.0.0.1
API_PORT=8000

# Correo (Fase 3) - destinatario de las notificaciones
MAIL_TO=tu-correo@ejemplo.com

# SMTP (Fase 3) - Gmail con App Password (16 caracteres, NO la contraseña
# normal de la cuenta; requiere 2FA activo -> generarla en la config de Google)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASSWORD=
MAIL_FROM=tu-correo@gmail.com
SMTP_USA_TLS=true

# URL base del portal (Fase 4) para los links de las cards del correo
PORTAL_BASE_URL=http://localhost:3000

# Adzuna (gratis, 1k llamadas/mes) - https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ATS - board tokens/slugs de las empresas objetivo, separados por coma
GREENHOUSE_BOARD_TOKENS=
LEVER_COMPANIES=
ASHBY_BOARD_NAMES=

# IA (Fase 2) - servidor con API OpenAI-compatible. En producción/servidor:
# Ollama (requirements.md §5.2, DECISIÓN). En desarrollo local también sirve
# LM Studio (mismo endpoint /v1/*, cambiar host/puerto/nombre del modelo).
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M
OLLAMA_MODELO_EMBEDDINGS=nomic-embed-text
OLLAMA_TIMEOUT_SEGUNDOS=120

# Ruta al perfil TOON. Relativa (default): resuelta contra la raíz de este
# repo asumiendo el checkout monorepo. Absoluta: para Docker, apuntar al
# path donde se monte el volumen con el perfil real.
PERFIL_PATH=../resources/perfil.toon
